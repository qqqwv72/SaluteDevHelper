<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нажатие OK на пульте -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_cyan" />
            <corners android:radius="@dimen/radius_row" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
    <!-- В фокусе: заполненная "пилюля", как в Projectivy Launcher -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_cyan" />
            <corners android:radius="@dimen/radius_row" />
        </shape>
    </item>
    <!-- Обычное состояние -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="@dimen/radius_row" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
