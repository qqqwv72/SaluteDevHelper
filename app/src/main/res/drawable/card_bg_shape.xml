<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нажатие на карточку пультом ДУ -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_elevated" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
    <!-- Карточка в фокусе пульта ДУ -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_elevated" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="2.5dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <!-- Покой -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
